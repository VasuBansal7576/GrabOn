# LLM Provider API Keys
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Target Codebase
TARGET_CODEBASE_PATH=./target/httpx

# Agent Configuration
LOG_LEVEL=INFO
MAX_ITERATIONS=5
COST_BUDGET_PER_TASK_USD=0.50
MAX_TOOL_CALLS_PER_TASK=50
MAX_WALL_CLOCK_SECONDS=300
MAX_CONSECUTIVE_FAILURES=3

# Cache
CACHE_DIR=.cache
INDEX_CACHE_ENABLED=true
