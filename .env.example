# LLM Provider API Keys
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
NVIDIA_MODEL=mistralai/mistral-small-4-119b-2603
NVIDIA_INPUT_COST_PER_1K=0.0
NVIDIA_OUTPUT_COST_PER_1K=0.0

# Target Codebase
TARGET_CODEBASE_PATH=./target/httpx

# Agent Configuration
LOG_LEVEL=INFO
MAX_ITERATIONS=5
COST_BUDGET_PER_TASK_USD=0.50
MAX_TOOL_CALLS_PER_TASK=50
MAX_WALL_CLOCK_SECONDS=300
MAX_CONSECUTIVE_FAILURES=3

# Cache
CACHE_DIR=.cache
INDEX_CACHE_ENABLED=true
QUEUE_STATE_PATH=.cache/task_queue_state.json
